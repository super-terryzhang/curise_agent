# ─── Database ────────────────────────────────────────────────────
# Shared with v2 (Supabase). For local dev, use SQLite:
#   DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cruise_system_dev

# ─── JWT ─────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-production

# ─── CORS ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Environment ─────────────────────────────────────────────────
ENV=development

# ─── External services (not required for Phase 0) ───────────────
# GOOGLE_API_KEY=
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=

# ─── Document AI (Phase 2+) ──────────────────────────────────────
# DOCUMENT_AI_PROJECT_ID=
# DOCUMENT_AI_PROCESSOR_ID=
# DOCUMENT_AI_LOCATION=us

# ─── Supabase Storage (Phase 2+) ─────────────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# STORAGE_BUCKET=v3-files

# ─── LINE Bot (Phase 4+) ─────────────────────────────────────────
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
