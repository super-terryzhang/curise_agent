# TEMPLATE ONLY. Resolve each target explicitly; inject real secrets at runtime.
# The placeholder signing key is deliberately rejected by production validation.
ENV=production
SECRET_KEY=replace-me-with-independent-random-runtime-secret
JWT_ISSUER=cruise-new-environment
JWT_AUDIENCE=cruise-api
DATABASE_URL=postgresql://runtime-user:REPLACE_AT_RUNTIME@database.example.test/cruise
STORAGE_BACKEND=gcs
STORAGE_BUCKET=REPLACE_WITH_PRIVATE_TARGET_BUCKET
PUBLIC_BACKEND_URL=https://backend.example.test
ALLOWED_ORIGINS=["https://frontend.example.test"]
LINE_DISABLE_SIGNATURE_VERIFICATION=false
LINE_BIND_BASE_URL=https://frontend.example.test
LINE_CHANNEL_ID=REPLACE_WITH_TARGET_CHANNEL_ID
# Set only after confirming the actual proxy chain. Never trust every address.
FORWARDED_ALLOW_IPS=127.0.0.1
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_MAX_DAYS=7
TEMPORARY_PASSWORD_HOURS=24
RESTRICTED_SESSION_MINUTES=15
REFRESH_RETRY_SECONDS=5
AUTH_SOURCE_PER_MINUTE=120
AUTH_ACCOUNT_PER_15_MINUTES=20
SECURITY_EVENT_RETENTION_DAYS=180
# Frontend build variable (set in frontend environment, not backend secret store):
# NEXT_PUBLIC_API_URL=https://backend.example.test
